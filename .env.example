# Flask Environment & Secrets
SECRET_KEY=your-secure-random-secret-key-here
FLASK_ENV=production

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct Connection)
# Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
STORAGE_BACKEND=database

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI is optional if Vercel / Render auto-detects HTTPS domain (e.g. https://your-app.vercel.app/login/google/callback)
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/login/google/callback
